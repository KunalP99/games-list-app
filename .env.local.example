# Supabase — get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — only needed for admin scripts (import-tickets, etc.)
# Never expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your app's public URL (used for email confirmation redirect)
# Use http://localhost:3000 for local dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RAWG game database API — get your key at rawg.io/apidocs (free, 20k req/month)
RAWG_API_KEY=baf1b37c1f6849ddb41e8021f2e0c4ed

# YouTube Data API v3 — for importing a playlist's videos on the Videos page.
# Google Cloud Console > enable "YouTube Data API v3" > Credentials > Create API key.
YOUTUBE_API_KEY=your-youtube-api-key
